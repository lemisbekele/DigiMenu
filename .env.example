# Client environment — copy to .env and fill in.
# VITE_* values are PUBLIC (bundled into the browser build). Never put
# service-role keys or VAPID private keys here.

# ── Option A: local Supabase stack (Docker, `supabase start`) ──
# URL/key come from `supabase status` after the stack is running.
# VITE_SUPABASE_URL="http://127.0.0.1:54321"
# VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# ── Option B: hosted Supabase project ──
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# Web Push public key (private key lives only in the send-push edge function).
VITE_VAPID_PUBLIC_KEY=""

# Optional: Cloudflare Worker address that serves menu photos (see cloudflare/README.md).
# Leave empty to load photos straight from Supabase.
VITE_IMAGE_CDN_URL=""
